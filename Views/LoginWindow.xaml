<Window x:Class="FoodSave.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoodSave • Masuk" Width="470" Height="540" MinWidth="420" MinHeight="500" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">
  <Grid Margin="42">
    <StackPanel VerticalAlignment="Center">
      <TextBlock Text="FoodSave" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
      <TextBlock Text="Kelola bahan, kurangi makanan terbuang." FontSize="15" Margin="0,5,0,26" Foreground="{StaticResource InkBrush}"/>
      <TextBlock x:Name="ModeTitle" Text="Masuk ke akun" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <StackPanel x:Name="NamePanel" Visibility="Collapsed">
        <TextBlock Text="Nama"/><TextBox x:Name="NameBox" MaxLength="120"/>
      </StackPanel>
      <TextBlock Text="Email"/><TextBox x:Name="EmailBox" MaxLength="254"/>
      <TextBlock Text="Kata sandi"/><PasswordBox x:Name="PasswordInput"/>
      <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <Button x:Name="SubmitButton" Content="Masuk" Click="Submit_Click" Margin="0,5,0,7"/>
      <Button x:Name="SwitchButton" Content="Belum punya akun? Daftar" Click="Switch_Click" Background="Transparent" Foreground="{StaticResource AccentBrush}"/>
    </StackPanel>
  </Grid>
</Window>
