<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FoodSave</RootNamespace>
    <AssemblyName>FoodSave</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.9" />
    <None Update="Database/schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="FoodSave.Tests/**/*.cs" />
  </ItemGroup>
</Project>
