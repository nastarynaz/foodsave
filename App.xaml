<Application x:Class="FoodSave.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="Views/LoginWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F6F7F2"/>
    <SolidColorBrush x:Key="InkBrush" Color="#20352B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#19775A"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="3"/>
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
    <Style TargetType="DatePicker"><Setter Property="Margin" Value="0,4,0,10"/></Style>
    <Style TargetType="DataGrid"><Setter Property="RowHeight" Value="35"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/></Style>
  </Application.Resources>
</Application>
